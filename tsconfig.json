{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "outDir": "dist",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@app/*": ["src/*"],
      "@electron/*": ["electron/*"],
      "@shared/*": ["shared/*"],
      "@saccades/*": ["saccades/*"],
      "@pupil/*": ["pupil/*"],
      "@viz/*": ["viz/*"]
    }
  },
  "include": [
    "src/**/*",
    "electron/**/*",
    "shared/**/*",
    "saccades/**/*",
    "pupil/**/*",
    "viz/**/*",
    "forge.env.d.ts"
  ]
}
