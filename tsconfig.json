{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "outDir": "dist",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@app/*": ["./src/*"],
      "@electron/*": ["./electron/*"],
      "@shared/*": ["./shared/*"],
      "@saccades": ["./saccades/index.ts"],
      "@saccades/*": ["./saccades/*"],
      "@pupil/*": ["./pupil/*"],
      "@viz/*": ["./viz/*"],
      "@cleaning": ["./cleaning/index.ts"],
      "@cleaning/*": ["./cleaning/*"]
    }
  },
  "include": [
    "src/**/*",
    "electron/**/*",
    "shared/**/*",
    "saccades/**/*",
    "pupil/**/*",
    "viz/**/*",
    "cleaning/**/*",
    "forge.env.d.ts"
  ]
}
